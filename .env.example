# Copy this file to .env and fill it in. .env is gitignored.
#
# SEC EDGAR requires every automated request to declare a contact address so it
# can reach you before it resorts to blocking. Requests without one are refused
# with 403 and the IP is blocked for roughly ten minutes.
#
# Format: "<app>/<version> <your-email>". Use an address you actually monitor.
#
# Leaving this unset is supported — the Earnings & Catalysts panel reports SEC
# filings as unavailable and everything else on the dashboard works normally.
SEC_USER_AGENT="regime-dashboard/1.0 you@example.com"
